@EcoscolarWebApi_HostAddress = http://localhost:5001/api/v1/

# Users

POST {{EcoscolarWebApi_HostAddress}}users/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "P@ssw0rd!",
  "firstName": "John",
  "lastName": "Doe"
}

###

GET {{EcoscolarWebApi_HostAddress}}users/me
Accept: application/json
Authorization: Bearer <JWT_TOKEN>

###

# Payments

# Server-priced checkout (P2): advert ids only, no price. Requires auth.
POST {{EcoscolarWebApi_HostAddress}}payments/checkout
Content-Type: application/json
Authorization: Bearer <JWT_TOKEN>

{
  "productIds": [1, 2],
  "shippingMethod": "handToHand"
}

###

# Stripe webhook (P4): called by Stripe, not manually. Signature verified against Stripe:WebhookSecret.
# Locally: stripe listen --forward-to localhost:5001/api/v1/payments/webhook
POST {{EcoscolarWebApi_HostAddress}}payments/webhook

###

POST {{EcoscolarWebApi_HostAddress}}payments/create-connect-account
Content-Type: application/json

{
  "email": "merchant@example.com"
}

###

POST {{EcoscolarWebApi_HostAddress}}payments/create-account-link
Content-Type: application/json

{
  "accountId": "acct_123456789"
}

###